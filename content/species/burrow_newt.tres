[gd_resource type="Resource" script_class="SpeciesDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/data/species_def.gd" id="1_species"]
[ext_resource type="Script" path="res://src/genetics/genome.gd" id="2_genome"]
[ext_resource type="Resource" path="res://content/body_plans/burrow_newt_small.tres" id="3_body"]

[sub_resource type="Resource" id="Genome_base"]
script = ExtResource("2_genome")
body_plan_id = &"burrow_newt_small"
trait_values = Dictionary[StringName, float]({
&"body_size": 0.90,
&"move_speed": 0.90,
&"metabolism": 1.15,
&"sensory_range": 1.10,
&"forelimb_dexterity": 1.10,
&"membrane_potential": 0.00,
&"regeneration": 1.00
})

[resource]
script = ExtResource("1_species")
id = &"burrow_newt"
display_key = &"species.burrow_newt"
body_plan = ExtResource("3_body")
base_genome = SubResource("Genome_base")
cognition_band = &"cunning"
diet_tags = Array[StringName]([&"carnivore"])
reproduction_tags = Array[StringName]([&"burrow_newt_clutch"])
