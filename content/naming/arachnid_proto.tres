&"group_descriptor": [{"tokens": [&"shadow", &"web"], "weight": 1.0}],
&"nest_descriptor": [{"tokens": [&"silver", &"web"], "weight": 3.0}, {"tokens": [&"shadow", &"burrow"], "weight": 1.0}],
&"territory_descriptor": [{"tokens": [&"silver", &"burrow"], "weight": 1.0}]
}
