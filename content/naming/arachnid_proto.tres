[gd_resource type="Resource" script_class="NamingProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/data/naming_profile.gd" id="1_profile"]

[resource]
script = ExtResource("1_profile")
profile_id = &"arachnid_proto"
onsets = Array[String](["sk", "th", "v", "kr", "z"])
nuclei = Array[String](["a", "i", "o", "ae"])
